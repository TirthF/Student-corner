# Backend Environment Variables
# Copy this file to .env and fill in your real values.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
# Get from: MongoDB Atlas → Your Cluster → Connect → Drivers → Connection String
# Replace <username>, <password>, and <dbname> with your values
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/campusos?retryWrites=true&w=majority

# ─── Firebase Admin SDK ───────────────────────────────────────────────────────
# Get from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# Download the JSON file and paste the values below (keep quotes, remove newlines)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ─── Cloudinary ───────────────────────────────────────────────────────────────
# Get from: Cloudinary Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── Email Domain Validation ──────────────────────────────────────────────────
# Students must register with this email domain.
# Change to @adit.ac.in for production. Use @gmail.com for testing.
ALLOWED_EMAIL_DOMAIN=@adit.ac.in

# ─── Frontend URL (for CORS) ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Seed Script ─────────────────────────────────────────────────────────────
# Used ONLY by seed.js to create the initial admin account
SEED_ADMIN_EMAIL=admin@adit.ac.in
SEED_ADMIN_PASSWORD=Admin@123456
SEED_STUDENT_EMAIL=student@adit.ac.in
SEED_STUDENT_PASSWORD=Student@123456
SEED_FACULTY_EMAIL=faculty@adit.ac.in
SEED_FACULTY_PASSWORD=Faculty@123456
