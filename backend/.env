# Replace <username>, <password> with your Atlas DB user credentials
MONGODB_URI=mongodb+srv://Meet:sinojiameet@collegedatabase.xlxmv3v.mongodb.net/campusos?retryWrites=true&w=majority&appName=CollegeDatabase


